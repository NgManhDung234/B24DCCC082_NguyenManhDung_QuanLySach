<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F6FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THƯ VIỆN SÁCH CỦA TÔI"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#243B64"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvStatistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng số sách: 0"
        android:textSize="18sp"
        android:textColor="#243B64"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAddBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ THÊM SÁCH"
        android:textColor="#263754"
        android:backgroundTint="#D2BCFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/lvBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F4F6FA"
        android:clipToPadding="false"
        android:divider="#D8DDE6"
        android:dividerHeight="8dp"
        android:paddingBottom="8dp" />

</LinearLayout>
